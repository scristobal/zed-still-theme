// Still for Zed: semantic token settings.
// Generated by `npm run build`. Merge into settings.json, placing these rules
// before any existing semantic_token_rules.
{
	"semantic_tokens": "combined",
	"global_lsp_settings": {
		"semantic_token_rules": [
			{ "token_type": "variable", "token_modifiers": ["callable", "declaration"], "style": ["function.definition"] },
			{ "token_type": "variable", "token_modifiers": ["callable", "definition"], "style": ["function.definition"] },
			{ "token_type": "function", "token_modifiers": ["declaration"], "style": ["function.definition"] },
			{ "token_type": "function", "token_modifiers": ["definition"], "style": ["function.definition"] },
			{ "token_type": "method", "token_modifiers": ["declaration"], "style": ["function.definition"] },
			{ "token_type": "method", "token_modifiers": ["definition"], "style": ["function.definition"] },
			{ "token_type": "macro", "token_modifiers": ["declaration"], "style": ["function.definition"] },
			{ "token_type": "macro", "token_modifiers": ["definition"], "style": ["function.definition"] },
			{ "token_type": "namespace", "token_modifiers": ["declaration"], "style": ["type.definition"] },
			{ "token_type": "namespace", "token_modifiers": ["definition"], "style": ["type.definition"] },
			{ "token_type": "typeAlias", "token_modifiers": ["declaration"], "style": ["type.definition"] },
			{ "token_type": "typeAlias", "token_modifiers": ["definition"], "style": ["type.definition"] },
			{ "token_type": "union", "token_modifiers": ["declaration"], "style": ["type.definition"] },
			{ "token_type": "union", "token_modifiers": ["definition"], "style": ["type.definition"] },
			{ "token_type": "variable", "token_modifiers": ["declaration"], "style": ["variable.definition"] },
			{ "token_type": "variable", "token_modifiers": ["definition"], "style": ["variable.definition"] },
			{ "token_type": "parameter", "token_modifiers": ["declaration"], "style": ["variable.definition"] },
			{ "token_type": "parameter", "token_modifiers": ["definition"], "style": ["variable.definition"] },
			{ "token_type": "property", "token_modifiers": ["declaration"], "style": ["variable.definition"] },
			{ "token_type": "property", "token_modifiers": ["definition"], "style": ["variable.definition"] },
			{ "token_type": "enumMember", "token_modifiers": ["declaration"], "style": ["variable.definition"] },
			{ "token_type": "enumMember", "token_modifiers": ["definition"], "style": ["variable.definition"] },
			{ "token_type": "parameter", "style": ["variable"] }
		]
	}
}
